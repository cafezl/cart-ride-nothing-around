{
  "name": "nothrilo-key-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/ui.js",
    "test": "node --test test/*.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "predeploy": "pnpm run check && pnpm test",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.102.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
