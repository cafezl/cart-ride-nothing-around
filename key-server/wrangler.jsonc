{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nothrilo-key",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "vars": {
    "SESSION_TTL_SECONDS": "900",
    "KEY_TTL_SECONDS": "86400",
    "WORKINK_URL": "REPLACE_AFTER_DEPLOY",
    "WORKINK_LINK_ID": "REPLACE_AFTER_DEPLOY",
    "LOOTLABS_URL": "REPLACE_AFTER_DEPLOY",
    "LINKVERTISE_URL": "REPLACE_AFTER_DEPLOY"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KEY_STORE",
        "class_name": "KeyStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KeyStore"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
