{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nothrilo-key",
  "main": "src/index.js",
  "minify": true,
  "compatibility_date": "2026-08-15",
  "vars": {
    "SESSION_TTL_SECONDS": "900",
    "KEY_TTL_SECONDS": "86400",
    "WORKINK_URL": "https://work.ink/2QMb/nothrilo-key",
    "WORKINK_LINK_ID": "4880288",
    "LOOTLABS_URL": "https://loot-link.com/s?xUdAxd7k=",
    "LINKVERTISE_URL": "https://direct-link.net/8313071/zWPoLO8Zf1aq"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KEY_STORE",
        "class_name": "KeyStore"
      }
    ]
  },
  "exports": {
    "KeyStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
